# Copy to .env on the VPS and replace all examples before starting.
# Prefer an immutable version tag or digest rather than latest.
MCP_IMAGE=ghcr.io/acetaxxxx/taiwan-card-rewards-mcp:sha-REPLACE_WITH_COMMIT
MCP_HTTP_HOST_PORT=8080
MCP_HTTP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
MCP_CF_ACCESS_AUDIENCE=REPLACE_WITH_ACCESS_APPLICATION_AUD
# Optional: exact comma-separated origins or extra hostnames, if needed.
# MCP_HTTP_ALLOWED_ORIGINS=https://example.com
# MCP_HTTP_ALLOWED_HOSTS=internal.example.com
# MCP_HTTP_MAX_TENANTS=1000
